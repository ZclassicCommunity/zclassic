{"jsonrpc":"2.0","id":3,"result":{"tools":[{"name":"zcl_guide","description":"Brief for the files you will touch: nearest AGENTS.md rules, local-ci steps, lessons, traps, first commands.","inputSchema":{"type":"object","properties":{"paths":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":8,"description":"repository-relative paths"}},"required":["paths"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_select","description":"Which local-ci steps the diff against base needs (default origin/master).","inputSchema":{"type":"object","properties":{"base":{"type":"string","description":"git ref, default origin/master"}},"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_tests","description":"The smallest focused test set (Boost suites, gtest suites, qa scripts, ci steps) for each path.","inputSchema":{"type":"object","properties":{"paths":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":8}},"required":["paths"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_code","description":"Code intelligence: map | owner <path> | impact <path> [--tests] [--depth=N] | file <path> | sym <name> | refs <name> | cost <path> | recent [--since=7d] | body <path> <func>. Optional --after=N pages.","inputSchema":{"type":"object","properties":{"sub":{"type":"string","enum":["map","owner","impact","file","sym","refs","cost","recent","body"]},"args":{"type":"array","items":{"type":"string"},"maxItems":5}},"required":["sub"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_wiki","description":"Walk the docs tree one topic at a time; omit topic for the root.","inputSchema":{"type":"object","properties":{"topic":{"type":"string"},"after":{"type":"integer","minimum":0}},"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_read","description":"Read a tracked repository file in chunks of at most 16 KiB; key and wallet files are refused.","inputSchema":{"type":"object","properties":{"path":{"type":"string"},"offset":{"type":"integer","minimum":0},"bytes":{"type":"integer","minimum":1}},"required":["path"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_lessons","description":"Search the lessons, traps and facts documents (words are ANDed).","inputSchema":{"type":"object","properties":{"q":{"type":"string","description":"up to 8 words"}},"required":["q"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_know","description":"Answer from the closed facts table; UNKNOWN when no row names the term.","inputSchema":{"type":"object","properties":{"term":{"type":"string"}},"required":["term"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_lint","description":"Run one read-only lint rule (never updates a baseline or reseals).","inputSchema":{"type":"object","properties":{"rule":{"type":"string","enum":["no-new-jq","no-new-bash","banned-str","md-links","vendor","no-python","filesize","complexity","long-functions","warnsupp","doc-claims","doc-paths","version-facts","victory","secretlog","testiso","shellport","wallclock","consensus-seal"]}},"required":["rule"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_receipt","description":"Latest local-ci receipt of one step, read from <dir>/receipts.jsonl (default the checkout root).","inputSchema":{"type":"object","properties":{"step":{"type":"string"},"dir":{"type":"string","description":"receipt directory inside the checkout"}},"required":["step"],"additionalProperties":false},"annotations":{"readOnlyHint":true}},{"name":"zcl_doctor","description":"What this host lacks to build and test zclassicd, with the fix for each gap.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":true}}]}}
