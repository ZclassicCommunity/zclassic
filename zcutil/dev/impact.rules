# zcl-dev impact rules.  One rule per line:  glob|glob<TAB>token token ...
#
# A glob (Z23 platform_glob_match, '*' crosses '/') is matched against a repo-relative path.
# A token with a '/' is a qa script to run; any other token is a step of zcutil/local-ci.sh
# (daemon-linux, daemon-win64 and wallet-linux are stages, the rest are steps of `test`).
# '-' means "needs nothing"; 'ALL' selects every `test` step, as an unmapped path does.  Use
# ALL for consensus, chain state, the daemon wallet and the build system: a subset there could
# skip the consensus or wallet tests.  A changed path takes the union over every rule it matches.
# Markdown and doc/ files select the docs check (check-dev-tools) only and need no rule.
# An unmapped path selects EVERYTHING.  `zcl-dev check-rules` fails when a tracked file under
# src/, wallet/src, qa/ or zcutil/ matches no rule, or when a rule matches no tracked file.

# ---- build system and release scripts
Makefile.am|configure.ac|autogen.sh|build-aux/*|depends/*|src/Makefile.am|src/Makefile.test.include|src/Makefile.gtest.include|src/config/*|share/*|libzcashconsensus.pc.in|zcutil/build.sh|zcutil/build-release.sh|zcutil/build-linux-ci.sh|zcutil/install-deps.sh|zcutil/setup-mingw-toolchain.sh	ALL daemon-linux daemon-win64
src/.clang-format|zcutil/check-hardening.sh|zcutil/fetch-params.sh|zcutil/zsync.sh|zcutil/cleanup-tags.sh|src/*.rc|src/windows-utf8.manifest|src/obj/*	daemon-linux daemon-win64

# ---- local CI and the developer tool
zcutil/Makefile|zcutil/local-ci.sh|zcutil/local-ci-macos.sh|zcutil/dev/*|zcutil/agent/*|zcutil/tools/Z23_SOURCE.tsv|zcutil/tools/LICENSE.z23|zcutil/tools/NOTICE|zcutil/tools/revendor.sh|zcutil/tools/vendor-files.txt|zcutil/tools/vendor/*	check-dev-tools
zcutil/local-ci-smoke.sh	check-dev-tools regtest-smoke
zcutil/githooks/*	check-dev-tools

# ---- C23 core
src/c23/vendor/*|src/c23/services/vendor/*|src/c23/Z23_SOURCE.tsv|src/c23/services/Z23_SOURCE.tsv|src/c23/LICENSE.z23|src/c23/NOTICE|src/c23/services/LICENSE.z23|src/c23/services/NOTICE|src/c23/tools/*|src/c23/services/tools/*	check-c23-vendor check-c23-no-rust c23-run-linked test_bitcoin-full
src/c23/glue/*|src/c23/compat/*|src/c23/equihash/*|src/c23/sprout_prover/*|src/c23/services/glue/*|src/c23/vendor-equihash-pending/*	check-c23-no-rust c23-run-linked test_bitcoin-full zcash-gtest-full regtest-smoke daemon-win64
src/c23/test/*|src/c23/bench/*	c23-run-linked regtest-smoke
src/c23/tor/*	check-c23-tor-symbols tor-twonode tor-threenode tor-addrv2gossip
src/zcash/tree_root.c|src/test/tree_root_c_tests.c	tree-root-asan test_bitcoin-full

# ---- consensus, chain state and block storage
src/consensus/*|src/pow/*|src/pow.cpp|src/pow.h|src/script/*|src/primitives/*|src/arith_uint256.*|src/uint256.*|src/uint252.h|src/equihashmemo.*|src/crypto/*|src/zcash/*|src/hash.*|src/key.*|src/key_io.*|src/pubkey.*|src/keystore.*|src/base58.*|src/bech32.*|src/secp256k1/*|src/chainparams.*|src/chainparamsseeds.h	ALL
src/main.cpp|src/main.h|src/chain.*|src/checkpoints.*|src/coins.*|src/txdb.*|src/undo.h|src/parkedblockindex.h|src/dbwrapper.*|src/leveldb/*|src/txmempool.*|src/policy/*|src/miner.*|src/merkleblock.*|src/bloom.*|src/checkqueue.h|src/deprecation.*|src/transaction_builder.*	ALL qa/rpc-tests/chain_reindex_resume.sh qa/rpc-tests/chain_invalidate_kill.sh qa/rpc-tests/chain_flush_interval_kill.sh qa/rpc-tests/invalidateblock_restart.sh qa/rpc-tests/reindex_stale_header.sh qa/rpc-tests/prune_invalidate_reconsider.sh qa/rpc-tests/mempool_cap.sh
qa/rpc-tests/chain_*|qa/rpc-tests/invalidateblock_restart.sh|qa/rpc-tests/reindex_stale_header.sh|qa/rpc-tests/prune_invalidate_reconsider.sh|qa/rpc-tests/mempool_cap.sh|qa/rpc-tests/generate_nowallet.sh|qa/rpc-tests/replay_blocknotify.sh	regtest-smoke
src/zmq/*	test_bitcoin-full regtest-smoke

