TESTS += zcash-gtest
noinst_PROGRAMS += zcash-gtest

# tool for generating our public parameters.
# test_checktransaction.cpp MUST be before
# any test that calls SelectParams().
zcash_gtest_SOURCES = \
	gtest/main.cpp \
	gtest/utils.cpp \
	gtest/test_checktransaction.cpp \
	gtest/json_test_vectors.cpp \
	gtest/json_test_vectors.h
# These tests are order-dependent, because they
# depend on global state (see #1539)
if ENABLE_WALLET
zcash_gtest_SOURCES += \
	wallet/gtest/test_wallet_zkeys.cpp
endif
zcash_gtest_SOURCES += \
	gtest/test_tautology.cpp \
	gtest/test_asyncrpc_opid.cpp \
	gtest/test_deprecation.cpp \
	gtest/test_equihash.cpp \
	gtest/test_equihash_c23.cpp \
	gtest/test_httprpc.cpp \
	gtest/test_joinsplit.cpp \
	gtest/test_keys.cpp \
	gtest/test_keystore.cpp \
	gtest/test_noteencryption.cpp \
	gtest/test_mempool.cpp \
	gtest/test_merkletree.cpp \
	gtest/test_metrics.cpp \
	gtest/test_miner.cpp \
	gtest/test_pow.cpp \
	gtest/test_random.cpp \
	gtest/test_rpc.cpp \
	gtest/test_sapling_note.cpp \
	gtest/test_sapling_scan_batch.cpp \
	gtest/test_transaction.cpp \
	gtest/test_transaction_builder.cpp \
	gtest/test_upgrades.cpp \
	gtest/test_validation.cpp \
	gtest/test_txid.cpp \
	gtest/test_libzcash_utils.cpp \
	gtest/test_param_presence.cpp \
	gtest/test_pedersen_hash.cpp \
	gtest/test_checkblock.cpp \
	gtest/test_secp256k1_verify_parity.cpp \
	gtest/test_sha256_differential.cpp \
	gtest/sha256_reference.h \
	gtest/test_zip32.cpp \
	gtest/test_mainnet_blocks.cpp \
	gtest/test_phgr13.cpp \
	gtest/phgr13_vectors.h
if ENABLE_WALLET
zcash_gtest_SOURCES += \
	wallet/gtest/test_paymentdisclosure.cpp \
	wallet/gtest/test_backupwallet.cpp \
	wallet/gtest/test_tokenguard.cpp \
	wallet/gtest/test_wallet.cpp \
	wallet/gtest/test_wallet_oversize.cpp \
	wallet/gtest/test_wallet_note_state.cpp \
	wallet/gtest/test_wallet_perf.cpp \
	wallet/gtest/test_wallet_witness_index.cpp
endif

zcash_gtest_CPPFLAGS = $(AM_CPPFLAGS) $(BITCOIN_INCLUDES)
zcash_gtest_CXXFLAGS = $(AM_CXXFLAGS) $(PIE_FLAGS)

zcash_gtest_LDADD = -lgtest -lgmock $(LIBBITCOIN_SERVER) $(LIBZCL_TOKENGUARD) $(ZCL_TOR_LIBS) $(LIBBITCOIN_CLI) $(LIBBITCOIN_COMMON) $(LIBBITCOIN_UTIL) $(LIBBITCOIN_CRYPTO) $(LIBUNIVALUE) $(LIBLEVELDB) $(LIBMEMENV) \
  $(BOOST_LIBS) $(BOOST_UNIT_TEST_FRAMEWORK_LIB) $(LIBSECP256K1)
if ENABLE_ZMQ
zcash_gtest_LDADD += $(LIBBITCOIN_ZMQ) $(ZMQ_LIBS)
endif
if ENABLE_WALLET
zcash_gtest_LDADD += $(LIBBITCOIN_WALLET)
endif

zcash_gtest_LDADD += $(LIBZCASH_CONSENSUS) $(BDB_LIBS) $(SSL_LIBS) $(CRYPTO_LIBS) $(EVENT_PTHREADS_LIBS) $(EVENT_LIBS) $(LIBZCASH) $(LIBZCL_C23) $(LIBZCASH_LIBS)



zcash_gtest_LDFLAGS = $(RELDFLAGS) $(AM_LDFLAGS) $(LIBTOOL_APP_LDFLAGS) -static
EXTRA_zcash_gtest_DEPENDENCIES = c23-symbols.stamp
# The secp256k1 parity corpus also runs the script JSON vectors; Makefile.test.include generates the headers.
gtest/zcash_gtest-test_secp256k1_verify_parity.$(OBJEXT): test/data/script_valid.json.h test/data/script_invalid.json.h

zcash-gtest_check: zcash-gtest FORCE
	./zcash-gtest

zcash-gtest-expected-failures: zcash-gtest FORCE
	./zcash-gtest --gtest_filter=*DISABLED_* --gtest_also_run_disabled_tests
