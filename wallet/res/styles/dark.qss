/* ============================================================================
 * ZClassic wallet — "Greenback" theme (dark, default).
 * Central source of truth for the look and type scale. Loaded in main.cpp after
 * QApplication::setStyle("Fusion") and a matching dark QPalette. Pure restyle: no
 * widget, objectName or property hook is removed, so every function stays where
 * the code and the tests expect it.
 *
 * ----------------------------------------------------------------------------
 * SURFACES (deepest to highest; green-tinted graphite)
 *   rail       #080a09   left navigation
 *   page       #0b0e0c   window / page background
 *   card       #121714   cards, group boxes, hero
 *   inset      #181e1a   inputs, tables, rows inside a card
 *   raised     #1f2621   hover on an inset / secondary button
 *   hairline   #232b26   1px borders     strong hairline #2f3a33
 *   radius     14px cards, 10px controls, 999px-style pills
 *
 * TEXT
 *   text #e8ece9   dim #9aa59d (AA on every surface)   disabled #66706a
 *
 * MONEY GREEN (brand accent: actions, focus, selection, confident balance)
 *   fill #1f8f4e   hover #25a75c   pressed #187a41   light (text) #5fd38d
 *
 * PRIVACY SEMANTICS (unchanged; guarded by tst_logic PRIV-14, mirrored in
 * PrivacyBadgeDelegate): private/green #1f7a1f (+ #34c759 text),
 * public/amber #d9822b, de-shield/red #c0392b. Amber = PUBLIC everywhere; red is
 * reserved for a private -> transparent de-shield.
 * ============================================================================ */

/* ---- base ---- */
QWidget {
    background-color: #121714;
    color: #e8ece9;
    font-size: 13pt;
    selection-background-color: #1f8f4e;
    selection-color: #ffffff;
}
QMainWindow, QDialog { background-color: #0b0e0c; }
QTabWidget, QTabWidget > QWidget, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background-color: #0b0e0c;
}
QLabel { background: transparent; }
QToolTip {
    background-color: #1f2621; color: #e8ece9;
    border: 1px solid #2f3a33; border-radius: 8px; padding: 6px 10px;
}
QFrame[frameShape="4"], QFrame[frameShape="5"] {   /* HLine / VLine separators */
    background-color: #232b26; border: none; max-height: 1px;
}

/* ---- cards (group boxes become rounded surfaces with an inline caption) ---- */
QGroupBox {
    background-color: #121714;
    border: 1px solid #232b26;
    border-radius: 14px;
    margin-top: 0px;
    padding: 40px 16px 16px 16px;
    font-size: 11pt;
    font-weight: 700;
    color: #9aa59d;
}
QGroupBox::title {
    subcontrol-origin: border;
    subcontrol-position: top left;
    left: 18px; top: 14px;
    padding: 0px;
    background: transparent;
    color: #9aa59d;                       /* quiet caption; the content leads */
}
QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QRadioButton { font-size: 13pt; font-weight: 400; color: #e8ece9; }
/* No card-inside-a-card: content inside a card sits on the card itself. */
QGroupBox QTableView, QGroupBox QTreeView, QGroupBox QListView {
    border: none; border-radius: 0px; background-color: transparent;
}
QGroupBox QHeaderView::section { background-color: transparent; border-radius: 0px; }
QGroupBox QScrollArea { border: none; background: transparent; }
QGroupBox QScrollArea > QWidget > QWidget { background: transparent; }
/* Home "Summary" column: the balance hero is already a card, so its holder is
 * invisible structure (caption hidden; the hero carries "Private balance"). */
QGroupBox#groupBox {
    background: transparent; border: none; padding: 0px; margin: 0px;
}
QGroupBox#groupBox::title { color: transparent; }
/* Receive share card has no caption (its headline leads), so no caption gutter. */
QGroupBox#groupBox_6 { padding-top: 18px; }
/* Send: each recipient row is a group inside the "Send To" card; keep it flat. */
QGroupBox#verticalGroupBox {
    background: transparent; border: none; border-radius: 0px; padding: 4px 0px;
}

/* ---- balance labels (privacy = colour, everywhere) ---- */
QLabel#balTotal       { font-size: 18pt; font-weight: 700; color: #ffffff; }
QLabel#balSheilded    { font-size: 14pt; font-weight: 700; color: #34c759; }
QLabel#balTransparent { font-size: 14pt; font-weight: 700; color: #d9822b; }

/* ---- tabs (the bar is hidden behind the nav rail; dialogs still use tabs) ---- */
QTabWidget::pane { border: none; background: #0b0e0c; top: 0px; }
QDialog QTabWidget::pane { border: 1px solid #232b26; border-radius: 14px; background: #121714; top: -1px; }
QDialog QTabWidget > QWidget { background: #121714; }
QTabBar { background: transparent; }
QTabBar::tab {
    background: transparent; color: #9aa59d;
    padding: 9px 16px; margin-right: 4px;
    border: none; border-bottom: 2px solid transparent;
    font-size: 12pt; font-weight: 600;
}
QTabBar::tab:hover    { color: #e8ece9; }
QTabBar::tab:selected { color: #ffffff; border-bottom: 2px solid #1f8f4e; }

/* ---- buttons: secondary by default, money-green when primary/default ---- */
QPushButton, QToolButton {
    background-color: #181e1a; color: #e8ece9;
    border: 1px solid #2f3a33; border-radius: 10px;
    padding: 8px 18px; font-size: 12pt; font-weight: 600;
    min-height: 24px;                     /* control-height floor sized to the line box. Text controls
                                             size from font metrics (min-height + symmetric padding) and
                                             grow with the font; never clamp one with max-height. */
}
QToolButton { padding: 6px 10px; }
QPushButton:hover, QToolButton:hover { background-color: #1f2621; border-color: #3a473f; }
QPushButton:pressed, QToolButton:pressed { background-color: #141a16; }
QPushButton:focus { border-color: #1f8f4e; }
QPushButton:disabled, QToolButton:disabled { color: #66706a; background-color: #121714; border-color: #1c231e; }
QPushButton:default {
    background-color: #1f8f4e; border-color: #1f8f4e; color: #ffffff;
}
QPushButton:default:hover   { background-color: #25a75c; border-color: #25a75c; }
QPushButton:default:pressed { background-color: #187a41; border-color: #187a41; }
QPushButton:checked { background-color: rgba(31, 143, 78, 0.18); border-color: #1f8f4e; color: #ffffff; }
QPushButton:flat { background: transparent; border: none; }
QPushButton:flat:hover { background-color: #1f2621; }
QDialogButtonBox QPushButton { min-width: 84px; }

/* ---- inputs ---- */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit {
    background-color: #181e1a; color: #e8ece9;
    border: 1px solid #2f3a33; border-radius: 10px;
    padding: 7px 12px; min-height: 24px;
    selection-background-color: #1f8f4e;
}
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #3a473f; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #1f8f4e; background-color: #1a211c;
}
QLineEdit:read-only { color: #9aa59d; background-color: #121714; }
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled { color: #66706a; background-color: #121714; border-color: #1c231e; }
QTextBrowser { background-color: #121714; border: 1px solid #232b26; border-radius: 10px; padding: 8px; }

QComboBox {
    background-color: #181e1a; color: #e8ece9;
    border: 1px solid #2f3a33; border-radius: 10px;
    padding: 7px 12px; min-height: 24px;
}
QComboBox:hover { border-color: #3a473f; }
QComboBox:focus, QComboBox:on { border-color: #1f8f4e; }
QComboBox::drop-down { border: none; width: 30px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(:/icons/res/icons/chevron-down.svg); width: 14px; height: 14px; }
QComboBox::down-arrow:on { top: 1px; }
QToolButton#comboAddressInfo { background: transparent; border: none; padding: 4px; min-height: 16px; }
QToolButton#comboAddressInfo:hover { background-color: #1f2621; border-radius: 8px; }
QComboBox QAbstractItemView {
    background-color: #181e1a; color: #e8ece9;
    border: 1px solid #2f3a33; border-radius: 10px;
    selection-background-color: rgba(31, 143, 78, 0.35); selection-color: #ffffff;
    outline: 0; padding: 4px;
}

/* ---- tables and lists: no grid, airy rows, quiet header ---- */
QTableView, QTreeView, QListView {
    background-color: #121714; alternate-background-color: #141a16;
    color: #e8ece9; gridline-color: #121714;
    border: 1px solid #232b26; border-radius: 14px;
    selection-background-color: rgba(31, 143, 78, 0.28); selection-color: #ffffff;
    outline: 0;
}
QTableView::item, QTreeView::item, QListView::item {
    padding: 8px 12px; border: none; border-bottom: 1px solid #1a201c;
}
QTableView::item:hover, QTreeView::item:hover, QListView::item:hover { background-color: #181e1a; }
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
    background-color: rgba(31, 143, 78, 0.28); color: #ffffff;
}
QHeaderView { background-color: transparent; }
QHeaderView::section {
    background-color: #121714; color: #9aa59d;
    padding: 10px 12px; border: none; border-bottom: 1px solid #232b26;
    font-size: 11pt; font-weight: 700;
}
QHeaderView::section:first { border-top-left-radius: 14px; }
QHeaderView::section:last  { border-top-right-radius: 14px; }
QTableView QTableCornerButton::section { background-color: #121714; border: none; }

/* ---- menus / status / progress ---- */
QMenuBar { background-color: #080a09; color: #9aa59d; padding: 2px 6px; border-bottom: 1px solid #161b18; }
QMenuBar::item { background: transparent; padding: 5px 10px; border-radius: 6px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: #1f2621; color: #e8ece9; }
QMenu { background-color: #151a17; color: #e8ece9; border: 1px solid #2f3a33; border-radius: 10px; padding: 6px; }
QMenu::item { padding: 8px 24px 8px 14px; border-radius: 6px; background: transparent; }
QMenu::item:selected { background-color: rgba(31, 143, 78, 0.22); color: #ffffff; }
QMenu::item:disabled { color: #66706a; }
QMenu::separator { height: 1px; background: #232b26; margin: 6px 8px; }
QStatusBar { background-color: #080a09; color: #9aa59d; border-top: 1px solid #161b18; }
QStatusBar QLabel { color: #9aa59d; font-size: 11pt; }
QStatusBar::item { border: none; }
QProgressBar {
    background-color: #181e1a; border: 1px solid #232b26; border-radius: 10px;
    text-align: center; color: #e8ece9; min-height: 24px; font-size: 11pt; font-weight: 600;
}
QProgressBar::chunk { background-color: #1f8f4e; border-radius: 9px; }

/* ---- checks / radios ---- */
QRadioButton, QCheckBox { spacing: 10px; background: transparent; }
QRadioButton::indicator, QCheckBox::indicator { width: 18px; height: 18px; }
QCheckBox::indicator { border: 1px solid #3a473f; border-radius: 6px; background: #181e1a; }
QCheckBox::indicator:hover { border-color: #1f8f4e; }
QCheckBox::indicator:checked { background: #1f8f4e; border-color: #1f8f4e; }
QCheckBox::indicator:disabled { background: #121714; border-color: #232b26; }
QRadioButton::indicator { border: 1px solid #3a473f; border-radius: 9px; background: #181e1a; }
QRadioButton::indicator:hover { border-color: #1f8f4e; }
/* Checked dot is private/green. The TRANSPARENT (t-Addr) radio carries
 * property public=true so its dot is AMBER: colour always equals privacy state. */
QRadioButton::indicator:checked { background: #1f7a1f; border: 4px solid #181e1a; outline: none; }
QRadioButton[public="true"]::indicator:checked { background: #d9822b; border-color: #181e1a; }
QRadioButton[public="true"] { color: #f0b878; }

/* ---- scrollbars: thin, out of the way ---- */
QScrollBar:vertical   { background: transparent; width: 10px; margin: 4px 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 4px; }
QScrollBar::handle:vertical   { background: #2a332d; border-radius: 3px; min-height: 32px; }
QScrollBar::handle:horizontal { background: #2a332d; border-radius: 3px; min-width: 32px; }
QScrollBar::handle:hover { background: #3a473f; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* ============================================================================
 * NAV RAIL (mainwindow.cpp setupNavRail). Brand header (ZClassic mark +
 * wordmark), icon + label destinations, and a bottom group of shortcuts
 * (Address book, Settings, Node). The selected destination is a soft green pill.
 * ============================================================================ */
QFrame#navRail {
    background-color: #080a09;
    border: none;
    border-right: 1px solid #161b18;
}
QFrame#navRail QWidget { background: transparent; }
QLabel#navBrandMark { padding: 0px; }
QLabel#navBrandName { color: #ffffff; font-size: 15pt; font-weight: 700; padding: 0px; }
QLabel#navBrandSub  { color: #9aa59d; font-size: 10pt; font-weight: 600; padding: 0px; }
QLabel#navSectionLabel {
    color: #66706a; font-size: 9pt; font-weight: 700;
    padding: 14px 14px 4px 14px; letter-spacing: 1px;
}
QFrame#navRail QPushButton[navrail="true"] {
    background: transparent;
    color: #9aa59d;
    border: none;
    border-radius: 10px;
    padding: 9px 14px;
    margin: 0px;
    text-align: left;
    font-size: 13pt;
    font-weight: 600;
}
QFrame#navRail QPushButton[navrail="true"]:hover {
    background-color: #121714;
    color: #e8ece9;
}
QFrame#navRail QPushButton[navrail="true"]:checked {
    background-color: rgba(31, 143, 78, 0.16);
    color: #ffffff;
}
QFrame#navRail QPushButton[navrail="true"]:focus { outline: none; }
QFrame#navRail QPushButton[navrail="true"]:disabled { color: #4f5952; }   /* waiting for the node */
/* Secondary rail entries (shortcuts + the Node page): a step smaller. Their
 * label never drops below the AA dim token. */
QFrame#navRail QPushButton[navrailadv="true"] {
    font-size: 12pt;
    font-weight: 500;
    color: #9aa59d;
    padding: 6px 14px;
}
QFrame#navRail QPushButton[navrailadv="true"]:hover   { color: #e8ece9; }
QFrame#navRail QPushButton[navrailadv="true"]:checked { color: #ffffff; }

/* ============================================================================
 * HOME DASHBOARD (mainwindow.cpp setupHomeDashboard): private balance hero,
 * quick actions, amber fix-it cards.
 * ============================================================================ */
QFrame#homeHero {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                      stop:0 #14261b, stop:0.55 #121a15, stop:1 #121714);
    border: 1px solid #23392b;
    border-radius: 18px;
}
QFrame#homeHero QLabel { background: transparent; }
QLabel#homeHeroCaption {
    color: #9aa59d;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 1px;
}
/* The PRIVATE balance is the hero. Colour is state-driven via heroconfident
 * (updateHomeFixIt): money green ONLY on the synced edge; neutral grey while the
 * number is cached / warming / mid-sync, so a not-yet-final balance never looks
 * final. relayoutHero() sets the font size inline to fit the full amount. */
QLabel#homeHeroPrivate {
    color: #9aa59d;
    font-size: 40pt;
    font-weight: 700;
}
QLabel#homeHeroPrivate[heroconfident="true"]  { color: #5fd38d; }
QLabel#homeHeroPrivate[heroconfident="false"] { color: #9aa59d; }
QLabel#homeHeroTotal     { color: #9aa59d; font-size: 13pt; font-weight: 500; }
QLabel#homeHeroQualifier { color: #9aa59d; font-size: 11pt; font-weight: 500; font-style: italic; }
QLabel#homeHeroHelper    { color: #9aa59d; font-size: 13pt; font-weight: 500; }

/* Quick actions, keyed on the homeaction PROPERTY so updateHomeFixIt() can swap
 * which one leads (Receive when empty, Send once funded). */
QFrame#homeQuickActions { background: transparent; border: none; }
QPushButton#homeSendBtn, QPushButton#homeReceiveBtn {
    border-radius: 12px;
    padding: 12px 18px; font-size: 13pt; font-weight: 700;
    min-height: 24px;
}
QPushButton[homeaction="primary"] {
    background-color: #1f8f4e; color: #ffffff;
    border: 1px solid #1f8f4e;
}
QPushButton[homeaction="primary"]:hover   { background-color: #25a75c; border-color: #25a75c; }
QPushButton[homeaction="primary"]:pressed { background-color: #187a41; border-color: #187a41; }
QPushButton[homeaction="secondary"] {
    background-color: #181e1a; color: #e8ece9;
    border: 1px solid #2f3a33; font-weight: 600;
}
QPushButton[homeaction="secondary"]:hover   { background-color: #1f2621; border-color: #3a473f; }
QPushButton[homeaction="secondary"]:pressed { background-color: #141a16; }

/* Fix-it cards: amber-tinted guidance (PUBLIC funds, backup), not alarm. */
QFrame#homeFixItCard {
    background-color: rgba(217, 130, 43, 0.08);
    border: 1px solid rgba(217, 130, 43, 0.28);
    border-radius: 14px;
}
QFrame#homeFixItCard QLabel { background: transparent; }
QLabel#homeFixItText {
    color: #f0b878;
    font-size: 12pt;
    font-weight: 600;
}
QPushButton#homeFixItBtn {
    background-color: #d9822b; color: #120c06;
    border: 1px solid #d9822b; border-radius: 10px;
    padding: 9px 18px; font-size: 12pt; font-weight: 700;
    min-height: 24px;
}
QPushButton#homeFixItBtn:hover   { background-color: #e39545; border-color: #e39545; }
QPushButton#homeFixItBtn:pressed { background-color: #c2731f; }

/* ============================================================================
 * SYNC BANNER (setupSyncBanner / setSyncStatus). The tinted card for each state
 * is set in code (bannerSheet); at rest only this quiet pill shows.
 * ============================================================================ */
QLabel#syncQuietPill {
    background-color: transparent;
    color: #9aa59d;
    font-size: 12pt;
    font-weight: 600;
    padding: 2px 0px;
}

/* ============================================================================
 * RECEIVE (private by default; setupReceivePrivacyDisclosure).
 * ============================================================================ */
QLabel#lblReceivePrivate {
    color: #34c759;
    font-size: 12pt;
    font-weight: 700;
    padding: 2px 0px;
}
/* The QR must stay on white for scanners; the card supplies frame + quiet zone. */
QFrame#receiveQrCard {
    background-color: #ffffff;
    border: 1px solid #232b26;
    border-radius: 16px;
    padding: 16px;
}
QPushButton#btnReceiveCopy, QPushButton#btnReceiveCopyRequest {
    background-color: #1f8f4e; color: #ffffff;
    border: 1px solid #1f8f4e; border-radius: 10px;
    padding: 9px 20px; font-size: 12pt; font-weight: 700;
    min-height: 24px;
}
QPushButton#btnReceiveCopy:hover, QPushButton#btnReceiveCopyRequest:hover     { background-color: #25a75c; border-color: #25a75c; }
QPushButton#btnReceiveCopy:pressed, QPushButton#btnReceiveCopyRequest:pressed { background-color: #187a41; border-color: #187a41; }
QLabel#lblReceiveHeadline { font-size: 20pt; font-weight: 700; color: #ffffff; }
/* The full address beside the QR: shown once, selectable, monospace, no box. */
QPlainTextEdit#txtRecieve {
    background: transparent; border: none; padding: 0px;
    color: #e8ece9;
    font-family: "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 12pt;
}
QLabel#lblReceiveListHint { color: #9aa59d; font-size: 11pt; }
/* Address-type tabs (segmented control): the selected tab takes its privacy
 * colour, green for Private, amber for Transparent. */
QFrame#receiveTypeTabs {
    background-color: #0b0e0c; border: 1px solid #232b26; border-radius: 12px;
}
QPushButton[segment="true"] {
    background: transparent; border: none; border-radius: 9px;
    padding: 6px 18px; min-height: 22px;
    color: #9aa59d; font-size: 12pt; font-weight: 600;
}
QPushButton[segment="true"]:hover   { color: #e8ece9; background: #141a16; }
QPushButton[segment="true"]:checked { background-color: #1f2621; color: #ffffff; }
QPushButton#receiveTabPrivate:checked { background-color: rgba(31, 122, 31, 0.28); color: #5fd38d; }
QPushButton#receiveTabPublic:checked  { background-color: rgba(217, 130, 43, 0.20); color: #f0b878; }
QLabel#receivePageLabel { color: #9aa59d; font-size: 11pt; padding: 0px 6px; }
/* The full-address card opened from an address cell's "i" icon (addresscell.cpp). */
QFrame#addressPopup {
    background-color: #151a17; border: 1px solid #2f3a33; border-radius: 12px;
}
QFrame#addressPopup QLabel#addressPopupText {
    color: #e8ece9; background: transparent;
    font-family: "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 12pt;
}
QFrame#addressPopup QPushButton#addressPopupCopy {
    background-color: #1f8f4e; border-color: #1f8f4e; color: #ffffff; padding: 6px 18px;
}
QFrame#addressPopup QPushButton#addressPopupCopy:hover { background-color: #25a75c; border-color: #25a75c; }
/* Per-row Copy / Export key icon buttons in "Your addresses". */
QWidget#receiveRowActions { background: transparent; }
QToolButton#rowCopy, QToolButton#rowExportKey, QToolButton#bookSendTo, QToolButton#bookDelete {
    background: transparent; border: 1px solid transparent; border-radius: 8px;
    padding: 4px; min-height: 16px;
}
QToolButton#rowCopy:hover, QToolButton#rowExportKey:hover, QToolButton#bookSendTo:hover, QToolButton#bookDelete:hover { background-color: #1f2621; border-color: #2f3a33; }
QLabel#lblReceiveSubhead  { color: #9aa59d; }
QLineEdit#txtReceiveAmount, QLineEdit#txtReceiveMemo { border-radius: 10px; }
QLabel#lblReceiveAddressCaption {
    color: #9aa59d;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 1px;
}
QToolButton#btnReceiveAdvanced {
    background: transparent;
    color: #9aa59d;
    border: none;
    border-radius: 8px;
    padding: 6px 6px;
    font-size: 11pt;
    font-weight: 600;
    text-align: left;
}
QToolButton#btnReceiveAdvanced:hover   { color: #e8ece9; background: transparent; }
QToolButton#btnReceiveAdvanced:checked { color: #e8ece9; }
QToolButton#btnReceiveAdvanced::menu-indicator { image: none; }
QWidget#receiveAdvancedPanel { background: transparent; }
QLabel#lblReceiveAdvancedCaption {
    color: #9aa59d;
    font-size: 10pt;
    font-weight: 500;
    padding-bottom: 2px;
}

/* ============================================================================
 * DE-SHIELD danger (red #c0392b, reserved for private -> transparent leaks).
 * Real rules, so the PRIV-14 token guard protects shipped styles.
 * ============================================================================ */
QLabel#publicWarning[deshield="true"] {
    color: #c0392b;
    font-weight: 600;
}
.deshield, QLabel[badgeKind="deshield"] {
    background-color: rgba(192, 57, 43, 0.14);
    border: 1px solid #c0392b;
    border-radius: 8px;
    color: #c0392b;
    padding: 2px 8px;
    font-weight: 700;
}

/* ============================================================================
 * PRIVACY BADGE (one pill, three tones). Tables use the painted
 * PrivacyBadgeDelegate with the same tokens.
 * ============================================================================ */
QLabel[badge="true"] {
    border-radius: 11px;
    padding: 2px 10px;
    min-height: 24px;                     /* >= line box + padding; never a max-height clamp */
    font-size: 11pt;
    font-weight: 700;
}
QLabel[badge="true"][tone="private"] {
    background-color: rgba(31, 122, 31, 0.18);
    border: 1px solid #1f7a1f;
    color: #34c759;
}
QLabel[badge="true"][tone="public"] {
    background-color: rgba(217, 130, 43, 0.15);
    border: 1px solid #d9822b;
    color: #f0b878;
}
QLabel[badge="true"][tone="deshield"] {
    background-color: rgba(192, 57, 43, 0.15);
    border: 1px solid #c0392b;
    color: #e06b5e;
}

/* ============================================================================
 * SEND FORM affordances.
 * ============================================================================ */
QLabel#sendPrivacyBadge {
    padding: 6px 10px;
    color: #9aa59d;
    font-style: italic;
}
QLineEdit#sendAddressBalance {
    border: none;
    background: transparent;
    font-weight: 700;
    color: #5fd38d;
}
QLabel#sendTotalsLine {
    color: #c9d1cb;
    font-weight: 600;
}

/* Softened PUBLIC callout (Receive transparent warning; property callout=public). */
QLabel[callout="public"] {
    background-color: rgba(217, 130, 43, 0.10);
    border: 1px solid rgba(217, 130, 43, 0.35);
    border-radius: 10px;
    color: #f0b878;
    padding: 10px 12px;
}

/* ---- dialogs ---- */
QDialog QLabel, QDialog QCheckBox, QDialog QRadioButton,
QDialog QLineEdit, QDialog QComboBox { font-size: 12pt; }
QDialog QGroupBox::title { font-size: 11pt; font-weight: 700; }
QMessageBox { background-color: #0b0e0c; }
QMessageBox QLabel { color: #e8ece9; }

/* Live address validation on Send recipients (sendtab.cpp addressChanged). */
QLineEdit[validation="valid"]   { border: 1px solid #34c759; }
QLineEdit[validation="invalid"] { border: 1px solid #c0392b; }

/* ============================================================================
 * PRIVATE-KEY / EXPORT dialog (objectNames set in mainwindow.cpp exportKeys()).
 * ============================================================================ */
QDialog#PrivKey { background-color: #0b0e0c; }
QLabel#privKeySecurity {
    color: #b4bdb6;
    font-size: 12pt;
    font-weight: 500;
    padding: 4px 2px 10px 2px;
}
QPlainTextEdit#privKeyTextEdit {
    background-color: #181e1a;
    color: #34c759;
    border: 1px solid #232b26;
    border-radius: 12px;
    padding: 10px 12px;
    font-family: "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 12pt;
    selection-background-color: #1f7a1f;
}
QPushButton#privKeyCopyBtn {
    background-color: transparent; color: #c9d1cb;
    border: 1px solid #2f3a33; border-radius: 10px;
    padding: 8px 18px; font-size: 12pt; font-weight: 600;
}
QPushButton#privKeyCopyBtn:hover   { background-color: #1f2621; border-color: #3a473f; }
QPushButton#privKeyCopyBtn:pressed { background-color: #141a16; }
QLabel#privKeyIntro {
    background-color: rgba(217, 130, 43, 0.10);
    color: #f0b878;
    border: 1px solid rgba(217, 130, 43, 0.35);
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 12pt;
    font-weight: 600;
}
QLabel#privKeyDoneLbl {
    color: #5fd38d;
    font-size: 12pt;
    font-weight: 600;
    padding: 6px 2px 4px 2px;
}
QLabel#privKeyCloseHint {
    color: #8a948d;
    font-size: 11pt;
    padding: 2px 2px 6px 2px;
}
QPushButton#privKeySaveBtn {
    background-color: #1f8f4e; color: #ffffff;
    border: 1px solid #1f8f4e; border-radius: 10px;
    padding: 8px 18px; font-size: 12pt; font-weight: 700;
}
QPushButton#privKeySaveBtn:hover   { background-color: #25a75c; border-color: #25a75c; }
QPushButton#privKeySaveBtn:pressed { background-color: #187a41; border-color: #187a41; }

/* Pay to: thin scroll bar along the field's bottom edge, only while the address is cut. */
QScrollBar#fieldScroll:horizontal { background: transparent; height: 4px; margin: 0px; border: none; }
QScrollBar#fieldScroll::handle:horizontal { background: #3a473f; border-radius: 2px; min-width: 24px; }
QScrollBar#fieldScroll::handle:horizontal:hover { background: #1f8f4e; }
QScrollBar#fieldScroll::add-line, QScrollBar#fieldScroll::sub-line { width: 0px; height: 0px; }

/* Settings page: option explanations are quieter than the option names. */
QLabel#settingsCaption { color: #9aa59d; font-size: 11pt; }

/* Backup page: status lines in the privacy tones, the phrase as a quiet grid. */
QLabel#backupStatus, QLabel#restoreHint { font-size: 12pt; }
QLabel#backupStatus[tone="ok"], QLabel#restoreHint[tone="ok"]     { color: #5fd38d; }
QLabel#backupStatus[tone="warn"], QLabel#restoreHint[tone="warn"] { color: #f0b878; }
QLabel#backupStatus[tone="dim"], QLabel#restoreHint[tone="dim"]   { color: #9aa59d; }
QWidget#phraseGrid QLabel#phraseWord {
    background-color: #181e1a; border: 1px solid #232b26; border-radius: 8px;
    padding: 6px 10px; font-family: "DejaVu Sans Mono", "Ubuntu Mono", monospace; font-size: 12pt;
}
QPlainTextEdit#restorePhrase {
    background-color: #181e1a; border: 1px solid #232b26; border-radius: 10px;
    padding: 6px 8px; font-family: "DejaVu Sans Mono", "Ubuntu Mono", monospace; font-size: 12pt;
}
QPlainTextEdit#restorePhrase:focus { border-color: #1f8f4e; }

/* ---- Node page (nodepage.cpp) ---- */
QScrollArea#nodeScroll, QScrollArea#nodeScroll > QWidget, QWidget#nodeBody { background: transparent; border: none; }
QFrame#nodeTile {
    background-color: #121714; border: 1px solid #232b26; border-radius: 14px;
}
QLabel#nodeTileCaption { color: #9aa59d; font-size: 11pt; font-weight: 700; }
QLabel#nodeTileValue, QLabel#nodeTileValueLead { color: #e8ece9; font-size: 18pt; font-weight: 700; }
QLabel#nodeTileValueLead { color: #5fd38d; }
QLabel#nodeTileNote { color: #9aa59d; font-size: 11pt; font-weight: 500; }
QGroupBox QLabel#nodeDim { color: #9aa59d; font-size: 11pt; }
QGroupBox QLabel#nodeFactName { color: #9aa59d; font-size: 12pt; }
QGroupBox QLabel#nodeFactValue { color: #e8ece9; font-size: 12pt; font-weight: 600; }
QGroupBox QLabel#nodeLookupResult { font-size: 12pt; color: #e8ece9; }
QGroupBox QLabel#nodeLookupResult[tone="warn"] { color: #f0b878; }
QTreeWidget#nodeBlocks { font-size: 12pt; }
QFrame#nodeBlockRow { border: none; border-bottom: 1px solid #1c231f; background: transparent; }
QGroupBox QLabel#nodeBlockHeight { color: #e8ece9; font-size: 13pt; font-weight: 700; }
QGroupBox QLabel#nodeBlockMeta { color: #c9d1cb; font-size: 12pt; }
QGroupBox QLabel#nodeBlockHash {
    color: #9aa59d; font-size: 11pt; font-family: "Consolas", "Menlo", "DejaVu Sans Mono", "Ubuntu Mono", monospace;
}
QToolButton#nodeBlockCopy { border: none; background: transparent; padding: 2px; }
